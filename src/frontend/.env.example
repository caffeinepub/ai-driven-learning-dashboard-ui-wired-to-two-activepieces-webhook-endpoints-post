# ActivePieces Webhook URLs
# You can use a single webhook URL for both actions by setting both variables to the same value,
# or set only one variable and the app will use it for both file upload and AI questions.
# The app sends an "action" field to distinguish between "process_notes" (file upload) and "ask_ai" (questions).

# Endpoint A: File upload and processing (returns summary + quiz_array)
VITE_ENDPOINT_A_URL=

# Endpoint B: Ask AI questions (returns ai_answer)
VITE_ENDPOINT_B_URL=
