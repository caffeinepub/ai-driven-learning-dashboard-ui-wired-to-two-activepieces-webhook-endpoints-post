# ActivePieces Webhook URL (OPTIONAL)
# 
# The app includes a built-in default webhook URL and works without any configuration.
# Set this variable only if you want to override the default webhook endpoint.
#
# The app automatically includes an "action" field in each request to distinguish between:
#   - "process_notes" (file upload - returns summary + quiz_array)
#   - "ask_ai" (AI questions - returns ai_answer)

# VITE_WEBHOOK_URL=https://cloud.activepieces.com/api/v1/webhooks/YOUR_WEBHOOK_ID/sync
